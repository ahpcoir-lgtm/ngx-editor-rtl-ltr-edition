  "description": "A fork of ngx-editor with first-class RTL/LTR support, Persian and Arabic locales and fonts, stronger image upload and video embedding. Rich text editor for Angular, built on ProseMirror",
  "license": "MIT",
  "type": "module",
  "contributors": [
    "Sibiraj (original ngx-editor author)",
    "Amir Farid Abbasi",
    "Amin Abbasi"
  ],
  "repository": "https://github.com/ahpcoir-lgtm/ngx-editor-rtl-ltr-edition.git",
  "bugs": "https://github.com/ahpcoir-lgtm/ngx-editor-rtl-ltr-edition/issues",
  "homepage": "https://github.com/ahpcoir-lgtm/ngx-editor-rtl-ltr-edition",
  "keywords": [
    "angular-editor",
    "angular-wysiwyg-editor",
    "wysiwyg-editor",
    "ngx-editor",
    "prosemirror",
    "rtl",
    "bidi",
    "persian",
    "farsi",
    "arabic",
    "urdu"
